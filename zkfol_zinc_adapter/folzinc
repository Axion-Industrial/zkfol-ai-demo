#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
VENV_DIR="${FOLZINC_VENV:-$PROJECT_DIR/.venv}"
REFERENCE_DIR="${FOLZINC_REFERENCE:-$PROJECT_DIR/zkfol_reference}"
PYTHON_BIN="${FOLZINC_PYTHON:-python3}"

# Make this wrapper work both after editable pip installs and in the
# source-backed top-level bundle layout.  This mirrors the top-level ./folzinc
# wrapper so that a single ./setup.sh setup supports both entry points.
PY_PATHS=()
if [[ -d "$REFERENCE_DIR/src" ]]; then
  PY_PATHS+=("$REFERENCE_DIR/src")
fi
if [[ -d "$SCRIPT_DIR/src" ]]; then
  PY_PATHS+=("$SCRIPT_DIR/src")
fi
if [[ -d "$PROJECT_DIR/vendor" ]]; then
  PY_PATHS+=("$PROJECT_DIR/vendor")
fi
if [[ ${#PY_PATHS[@]} -gt 0 ]]; then
  PYTHONPATH_PREFIX="$(IFS=:; echo "${PY_PATHS[*]}")"
  export PYTHONPATH="$PYTHONPATH_PREFIX:${PYTHONPATH:-}"
fi

usage() {
  cat <<EOF
zkFOL -> Zinc single-command wrapper

Usage:
  ./zkfol_zinc_adapter/folzinc setup [--reference DIR] [--venv DIR]
  ./zkfol_zinc_adapter/folzinc doctor [--build]
  ./zkfol_zinc_adapter/folzinc test [--cargo] [--zinc-smoke]
  ./zkfol_zinc_adapter/folzinc demo [--zinc] [--constraints]
  ./zkfol_zinc_adapter/folzinc inspect out/demo_power_2_4_public.json --constraints
  ./zkfol_zinc_adapter/folzinc run --example power --repeat 3
  ./zkfol_zinc_adapter/folzinc run --input out/power.json --repeat 3
  ./zkfol_zinc_adapter/folzinc bench power --skip-256 --run --repeat 3
  ./zkfol_zinc_adapter/folzinc estimate benchmark_inputs/power/*.json
  ./zkfol_zinc_adapter/folzinc bench fib --n 100 --run --repeat 3
  ./zkfol_zinc_adapter/folzinc bench fib --n 10000 --run --repeat 3 --int-limbs 128
  ./zkfol_zinc_adapter/folzinc bench fib --n 10000 --fib-profile full --run --repeat 1 --int-limbs 128
  ./zkfol_zinc_adapter/folzinc options

Default layout:
  project/
    zkfol_reference/
    zkfol_zinc_adapter/
    .venv/                 created by setup

Environment overrides:
  FOLZINC_VENV=/path/to/.venv
  FOLZINC_REFERENCE=/path/to/zkfol_reference
  FOLZINC_PYTHON=python3.12

The default demo is a public exact-integer proof of 2^4 = 16.
The main concrete-computation line is bolded in a real terminal.
Exact Fibonacci defaults to the faster compact profile; use --fib-profile full for the older explicit four-row trace.
Long Cargo/Zinc runs show a progress heartbeat by default; use --no-progress to suppress it.
Large runs are resource-preflighted before Zinc is launched; use estimate/preflight to inspect this.
Run './zkfol_zinc_adapter/folzinc test' for the Python regression suite. Add '--cargo' to check the Rust runner build and '--zinc-smoke' for a tiny real proof.
After setup, run './zkfol_zinc_adapter/folzinc <command> --help' for command help,
or './zkfol_zinc_adapter/folzinc options' for the complete practical option reference.
EOF
}

run_setup() {
  local ref_dir="$REFERENCE_DIR"
  local venv_dir="$VENV_DIR"
  local upgrade_pip=1
  local dev=0
  local system_site=0
  local build_isolation=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reference)
        ref_dir="$2"; shift 2 ;;
      --venv)
        venv_dir="$2"; shift 2 ;;
      --no-upgrade-pip)
        upgrade_pip=0; shift ;;
      --dev)
        dev=1; shift ;;
      --system-site-packages)
        system_site=1; shift ;;
      --no-build-isolation)
        build_isolation=0; shift ;;
      -h|--help)
        cat <<EOF
Usage: ./zkfol_zinc_adapter/folzinc setup [options]

Options:
  --reference DIR         zkfol_reference checkout. Default: $REFERENCE_DIR
  --venv DIR              virtual environment directory. Default: $VENV_DIR
  --no-upgrade-pip        skip pip/setuptools/wheel upgrade
  --dev                   also install requirements-dev.txt for tests
  --system-site-packages  create venv with access to system packages
  --no-build-isolation    pass --no-build-isolation to editable installs

Environment overrides:
  FOLZINC_VENV       default venv path
  FOLZINC_REFERENCE  default zkfol_reference path
  FOLZINC_PYTHON     Python executable used to create the venv
EOF
        return 0 ;;
      *)
        echo "unknown setup option: $1" >&2; return 2 ;;
    esac
  done

  if [[ ! -d "$ref_dir" ]]; then
    echo "Could not find zkfol_reference at: $ref_dir" >&2
    echo "Put zkfol_reference next to zkfol_zinc_adapter, or pass --reference DIR." >&2
    return 1
  fi

  echo "Creating/updating venv: $venv_dir"
  if [[ $system_site -eq 1 ]]; then
    "$PYTHON_BIN" -m venv --system-site-packages "$venv_dir"
  else
    "$PYTHON_BIN" -m venv "$venv_dir"
  fi
  local vpy="$venv_dir/bin/python"
  if [[ $upgrade_pip -eq 1 ]]; then
    "$vpy" -m pip install -U pip setuptools wheel
  fi
  local pip_extra=()
  if [[ $build_isolation -eq 0 ]]; then
    pip_extra+=(--no-build-isolation)
  fi
  "$vpy" -m pip install "${pip_extra[@]}" -e "$ref_dir"
  "$vpy" -m pip install "${pip_extra[@]}" -e "$SCRIPT_DIR"
  if [[ $dev -eq 1 ]]; then
    "$vpy" -m pip install -r "$SCRIPT_DIR/requirements-dev.txt"
  fi

  echo
  echo "Setup complete. Try:"
  echo "  ./zkfol_zinc_adapter/folzinc doctor"
  echo "  ./zkfol_zinc_adapter/folzinc demo"
  echo "  ./zkfol_zinc_adapter/folzinc test"
  echo
  echo "Optional activated-venv style:"
  echo "  . $venv_dir/bin/activate"
  echo "  folzinc demo"
}

need_venv() {
  if [[ ! -x "$VENV_DIR/bin/python" ]]; then
    echo "Virtual environment not found at: $VENV_DIR" >&2
    echo "Run: ./zkfol_zinc_adapter/folzinc setup" >&2
    return 1
  fi
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

cmd="$1"
shift || true

case "$cmd" in
  setup)
    run_setup "$@" ;;
  -h|--help)
    usage ;;
  options|option-reference)
    cat "$SCRIPT_DIR/docs/OPTIONS_REFERENCE.md" ;;
  help)
    if [[ -x "$VENV_DIR/bin/python" ]]; then
      "$VENV_DIR/bin/python" -m zkfol_zinc_adapter.cli --help
    else
      usage
    fi ;;
  *)
    need_venv
    exec "$VENV_DIR/bin/python" -m zkfol_zinc_adapter.cli "$cmd" "$@" ;;
esac
